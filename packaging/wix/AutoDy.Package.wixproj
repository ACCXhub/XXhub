<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.5.4</ProductVersion>
    <ProductCode Condition="'$(ProductCode)' == ''">*</ProductCode>
    <StageDir Condition="'$(StageDir)' == ''">$(MSBuildProjectDirectory)\stage</StageDir>
    <GeneratedWxs Condition="'$(GeneratedWxs)' == ''">$(MSBuildProjectDirectory)\GeneratedFiles.wxs</GeneratedWxs>
    <DefineConstants>ProductVersion=$(ProductVersion);ProductCode=$(ProductCode);StageDir=$(StageDir)</DefineConstants>
    <OutputName Condition="'$(Configuration)' == 'Debug'">AutoDy-$(ProductVersion)-x64-UNOFFICIAL-DEBUG</OutputName>
    <OutputName Condition="'$(Configuration)' != 'Debug'">AutoDy-$(ProductVersion)-x64</OutputName>
    <!-- ICE60 flags language-neutral third-party runtime binaries. -->
    <SuppressIces>ICE60</SuppressIces>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Bundle.wxs" />
    <Compile Include="$(GeneratedWxs)" />
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
  </ItemGroup>
</Project>