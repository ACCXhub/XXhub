<Project Sdk="WixToolset.Sdk/7.0.0">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <Platform>x64</Platform>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.5.4</ProductVersion>
    <MsiPath Condition="'$(MsiPath)' == ''">$(MSBuildThisFileDirectory)..\..\output\release\v$(ProductVersion)\AutoDy-$(ProductVersion)-x64.msi</MsiPath>
    <DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);MsiPath=$(MsiPath)</DefineConstants>
    <OutputName>AutoDy-Setup-$(ProductVersion)</OutputName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" Version="7.0.0" />
  </ItemGroup>
</Project>
