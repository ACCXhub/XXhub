<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="AutoDy"
    Manufacturer="AutoDy"
    Version="$(var.ProductVersion)"
    UpgradeCode="C8B3A04F-ABAB-4F4C-8A2C-7A1AE24F1400"
    Scope="perUser"
    InstallerVersion="500"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of AutoDy is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AutoDyIcon" SourceFile="$(var.StageDir)\assets\icons\autody.ico" />
    <Property Id="ARPPRODUCTICON" Value="AutoDyIcon" />
    <Property Id="INSTALLFOLDER">
      <RegistrySearch
        Id="InstalledFolderSearch"
        Root="HKCU"
        Key="Software\AutoDy"
        Name="InstallFolder"
        Type="raw" />
    </Property>
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <Feature Id="MainFeature" Title="AutoDy" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="DataRootComponent" />
      <ComponentRef Id="ShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AutoDy" />
      </Directory>
      <Directory Id="AUTODYDATAROOT" Name="AutoDy" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AutoDyProgramMenuFolder" Name="AutoDy" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <Component
      Id="DataRootComponent"
      Directory="AUTODYDATAROOT"
      Guid="F0814C5C-7B50-4F85-9D31-49C344F37814"
      Permanent="yes"
      NeverOverwrite="yes">
      <CreateFolder />
      <RemoveFolder Id="PreserveDataRoot" Directory="AUTODYDATAROOT" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\AutoDy"
        Name="DataRoot"
        Value="[AUTODYDATAROOT]"
        Type="string"
        KeyPath="yes" />
    </Component>
    <Component
      Id="ShortcutComponent"
      Directory="INSTALLFOLDER"
      Guid="0D3D1771-81B4-4D42-8DD8-1E13D093399B">
      <Shortcut
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Name="AutoDy Management"
        Description="AutoDy Management"
        Target="[SystemFolder]wscript.exe"
        Arguments="&quot;[INSTALLFOLDER]scripts\start-dashboard.vbs&quot;"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AutoDyIcon" />
      <Shortcut
        Id="StartMenuShortcut"
        Directory="AutoDyProgramMenuFolder"
        Name="AutoDy Management"
        Description="AutoDy Management"
        Target="[SystemFolder]wscript.exe"
        Arguments="&quot;[INSTALLFOLDER]scripts\start-dashboard.vbs&quot;"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AutoDyIcon" />
      <RemoveFolder Id="RemoveAutoDyProgramMenuFolder" Directory="AutoDyProgramMenuFolder" On="uninstall" />
      <RegistryValue
        Root="HKCU"
        Key="Software\AutoDy"
        Name="InstallFolder"
        Value="[INSTALLFOLDER]"
        Type="string" />
      <RegistryValue
        Root="HKCU"
        Key="Software\AutoDy"
        Name="InstalledVersion"
        Value="$(var.ProductVersion)"
        Type="string"
        KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
