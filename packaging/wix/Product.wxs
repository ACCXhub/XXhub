<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="AutoDy"
    Manufacturer="AutoDy"
    Version="$(var.ProductVersion)"
    ProductCode="$(var.ProductCode)"
    UpgradeCode="C8B3A04F-ABAB-4F4C-8A2C-7A1AE24F1400"
    Scope="perMachine"
    Codepage="65001"
    InstallerVersion="500"
    Compressed="yes">
    <MajorUpgrade DowngradeErrorMessage="A newer version of AutoDy is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
    <Icon Id="AutoDyIcon" SourceFile="$(var.StageDir)\assets\icons\autody.ico" />
    <Property Id="ARPPRODUCTICON" Value="AutoDyIcon" />
    <Property Id="AUTODY_INTERACTIVE_USER_SID" Secure="yes" />
    <Property Id="AUTODY_INTERACTIVE_LOCALAPPDATA" Secure="yes" />
    <Property Id="AUTODY_REGISTERED_INSTALLFOLDER" Value="Z:\__AutoDyNoExistingInstall__">
      <RegistrySearch
        Id="InstalledFolderSearch"
        Root="HKCU"
        Key="Software\AutoDy"
        Name="InstallFolder"
        Type="raw" />
    </Property>
    <Property Id="AUTODY_EXISTING_INSTALLFOLDER">
      <DirectorySearch
        Id="ExistingInstallFolderSearch"
        Path="[AUTODY_REGISTERED_INSTALLFOLDER]"
        Depth="0" />
    </Property>
    <Property Id="AUTODY_D_DRIVE">
      <DirectorySearch Id="AutoDyDDriveSearch" Path="D:\" Depth="0" />
    </Property>
    <SetProperty
      Action="CaptureInteractiveUserSid"
      Id="AUTODY_INTERACTIVE_USER_SID"
      Value="[UserSID]"
      After="AppSearch"
      Sequence="first"
      Condition="NOT AUTODY_INTERACTIVE_USER_SID" />
    <SetProperty
      Action="CaptureInteractiveLocalAppData"
      Id="AUTODY_INTERACTIVE_LOCALAPPDATA"
      Value="[LocalAppDataFolder]"
      After="CaptureInteractiveUserSid"
      Sequence="first"
      Condition="NOT AUTODY_INTERACTIVE_LOCALAPPDATA" />
    <SetProperty
      Action="SetAutoDyDataRoot"
      Id="AUTODYDATAROOT"
      Value="[AUTODY_INTERACTIVE_LOCALAPPDATA]AutoDy\"
      After="CaptureInteractiveLocalAppData"
      Sequence="both"
      Condition="AUTODY_INTERACTIVE_LOCALAPPDATA" />
    <SetProperty
      Action="SetExistingInstallFolder"
      Id="INSTALLFOLDER"
      Value="[AUTODY_EXISTING_INSTALLFOLDER]"
      After="AppSearch"
      Sequence="both"
      Condition="AUTODY_EXISTING_INSTALLFOLDER" />
    <SetProperty
      Action="SetDDriveInstallFolder"
      Id="INSTALLFOLDER"
      Value="D:\AutoDy"
      After="AppSearch"
      Sequence="both"
      Condition="NOT INSTALLFOLDER AND NOT AUTODY_EXISTING_INSTALLFOLDER AND AUTODY_D_DRIVE" />
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <CustomAction
      Id="StopExistingAutoDyTray"
      Directory="INSTALLFOLDER"
      ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]scripts\autody-tray.ps1&quot; -StopExisting"
      Execute="deferred"
      Impersonate="yes"
      Return="check" />
    <CustomAction
      Id="SetRepairInstalledAutoDyTasksData"
      Property="RepairInstalledAutoDyTasks"
      Value="&quot;[INSTALLFOLDER]runtime\python\python.exe&quot; -m autody.cli repair-scheduler --config &quot;[AUTODYDATAROOT]config.yaml&quot; --program-root &quot;[INSTALLFOLDER].&quot; --data-root &quot;[AUTODYDATAROOT].&quot; --task-user-id &quot;[AUTODY_INTERACTIVE_USER_SID]&quot;"
      Execute="immediate" />
    <CustomAction
      Id="RepairInstalledAutoDyTasks"
      Directory="INSTALLFOLDER"
      ExeCommand="[CustomActionData]"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <InstallExecuteSequence>
      <Custom
        Action="StopExistingAutoDyTray"
        After="InstallFiles"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="SetRepairInstalledAutoDyTasksData"
        After="StopExistingAutoDyTray"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="RepairInstalledAutoDyTasks"
        After="SetRepairInstalledAutoDyTasksData"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
    </InstallExecuteSequence>
    <Feature Id="MainFeature" Title="AutoDy" Level="1">
      <ComponentGroupRef Id="PayloadComponents" />
      <ComponentRef Id="DataRootComponent" />
      <ComponentRef Id="ShortcutComponent" />
    </Feature>
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="AutoDy" />
      </Directory>
      <Directory Id="AUTODYDATAROOT" Name="AutoDy" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AutoDyProgramMenuFolder" Name="AutoDy" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
  </Fragment>

  <Fragment>
    <Component
      Id="DataRootComponent"
      Directory="AUTODYDATAROOT"
      Guid="F0814C5C-7B50-4F85-9D31-49C344F37814"
      Permanent="yes"
      NeverOverwrite="yes">
      <CreateFolder />
      <RemoveFolder Id="PreserveDataRoot" Directory="AUTODYDATAROOT" On="uninstall" />
      <File
        Id="InitialConfigFile"
        Source="$(var.StageDir)\config.example.yaml"
        Name="config.yaml"
        KeyPath="yes" />
      <RegistryValue
        Root="HKU"
        Key="[AUTODY_INTERACTIVE_USER_SID]\Software\AutoDy"
        Name="DataRoot"
        Value="[AUTODYDATAROOT]"
        Type="string" />
    </Component>
    <Component
      Id="ShortcutComponent"
      Directory="INSTALLFOLDER"
      Guid="0D3D1771-81B4-4D42-8DD8-1E13D093399B">
      <Shortcut
        Id="DesktopShortcut"
        Directory="DesktopFolder"
        Name="AutoDy Management"
        Description="AutoDy Management"
        Target="[SystemFolder]wscript.exe"
        Arguments="&quot;[INSTALLFOLDER]scripts\start-dashboard.vbs&quot;"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AutoDyIcon" />
      <Shortcut
        Id="StartMenuShortcut"
        Directory="AutoDyProgramMenuFolder"
        Name="AutoDy Management"
        Description="AutoDy Management"
        Target="[SystemFolder]wscript.exe"
        Arguments="&quot;[INSTALLFOLDER]scripts\start-dashboard.vbs&quot;"
        WorkingDirectory="INSTALLFOLDER"
        Icon="AutoDyIcon" />
      <Shortcut
        Id="UninstallShortcut"
        Directory="AutoDyProgramMenuFolder"
        Name="卸载 AutoDy"
        Description="卸载 AutoDy"
        Target="[SystemFolder]msiexec.exe"
        Arguments="/x [ProductCode]"
        Icon="AutoDyIcon" />
      <RemoveFolder Id="RemoveAutoDyProgramMenuFolder" Directory="AutoDyProgramMenuFolder" On="uninstall" />
      <RegistryValue
        Root="HKU"
        Key="[AUTODY_INTERACTIVE_USER_SID]\Software\AutoDy"
        Name="InstallFolder"
        Value="[INSTALLFOLDER]"
        Type="string" />
      <RegistryValue
        Root="HKU"
        Key="[AUTODY_INTERACTIVE_USER_SID]\Software\AutoDy"
        Name="InstalledVersion"
        Value="$(var.ProductVersion)"
        Type="string"
        KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
